# Supply-chain hardening - node-security protocol 0.1.0 (npm 12 or later)
# Do not add ignore-scripts=true: in npm 12 it overrides allowScripts and stops project scripts.
# Do not add authentication tokens to a project .npmrc.

# Minimum age of a package version before npm installs it, in days (npm counts days, pnpm counts minutes).
min-release-age=3

# Do not resolve dependencies (direct or transitive) from git repositories.
allow-git=none

# Do not resolve dependencies (direct or transitive) from remote tarball URLs.
allow-remote=none
